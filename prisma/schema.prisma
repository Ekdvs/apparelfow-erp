generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUTTING_SUPERVISOR
  CUTTING_VERIFIER
  SEWING_SUPERVISOR
}

enum CuttingOrderStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  IN_SEWING
}

enum VerificationStatus {
  GREEN
  YELLOW
  RED
}

enum VerificationDecision {
  APPROVED
  REJECTED
}

model User {
  id               String             @id @default(uuid())
  email            String             @unique
  passwordHash     String
  role             UserRole
  fullName         String
  createdAt        DateTime           @default(now())

  cuttingOrders    CuttingOrder[]
  verificationLogs VerificationLog[]

  @@index([role])
  @@index([createdAt])
}

model Recipe {
  id             String             @id @default(uuid())
  recipeCode     String             @unique
  name           String
  category       String
  stdFabricYards Float
  wastageCap     Float

  components     RecipeComponent[]
  cuttingOrders  CuttingOrder[]

  createdAt      DateTime           @default(now())

  @@index([category])
  @@index([name])
  @@index([createdAt])
}

model RecipeComponent {
  id               String   @id @default(uuid())
  recipeId         String
  componentName    String
  piecesPerGarment Int
  imageUrl         String?

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  verificationItems VerificationItem[] @relation("VerificationItem_component")

  @@index([recipeId])
  @@index([componentName])
}

model CuttingOrder {
  id              String             @id @default(uuid())
  orderNo         String             @unique
  recipeId        String
  targetQty       Int
  fabricRollId    String
  actualFabricYds Float
  status          CuttingOrderStatus @default(PENDING_VERIFICATION)
  createdBy       String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  recipe Recipe @relation(fields: [recipeId], references: [id])

  creator User @relation(fields: [createdBy], references: [id])

  verificationItems VerificationItem[] @relation("VerificationItem_order")
  verificationLogs  VerificationLog[]

  sewingStartedAt DateTime?
  sewingStartedBy String?

  @@index([recipeId])
  @@index([createdBy])
  @@index([status])
  @@index([fabricRollId])
  @@index([createdAt])
  @@index([status, createdAt])
}

model VerificationItem {
  id          String             @id @default(uuid())
  orderId     String
  componentId String
  expectedQty Int
  actualQty   Int?
  status      VerificationStatus?

  order     CuttingOrder @relation("VerificationItem_order", fields: [orderId], references: [id], onDelete: Cascade)
  component RecipeComponent @relation("VerificationItem_component", fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([orderId, componentId])
  @@index([orderId])
  @@index([componentId])
  @@index([status])
}

model VerificationLog {
  id            String               @id @default(uuid())
  orderId       String
  verifierId    String
  decision      VerificationDecision
  rejectionNote String?
  wastagePct    Float
  timestamp     DateTime             @default(now())

  order CuttingOrder @relation(fields: [orderId], references: [id])

  verifier User @relation(fields: [verifierId], references: [id])

  @@index([orderId])
  @@index([verifierId])
  @@index([decision])
  @@index([timestamp])
  @@index([orderId, timestamp])
}